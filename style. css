body {
  font-family: "Segoe UI", Arial, sans-serif;
  margin: 0;
  padding: 0;
  background: #f9f9f9;
  color: #333;
  line-height: 1.6;
}

header {
  background: #1a1a1a;
  color: #fff;
  padding: 2rem;
  text-align: center;
}

header h1 {
  margin: 0;
  font-size: 2.5rem;
  font-weight: bold;
}

header p {
  margin: 0.5rem 0 0;
  font-size: 1.2rem;
  font-style: italic;
}

section {
  padding: 2rem;
  max-width: 900px;
  margin: auto;
}

h2 {
  color: #222;
  margin-top: 2rem;
  font-size: 1.5rem;
  border-bottom: 2px solid #0078d7;
  padding-bottom: 0.5rem;
}

ul {
  margin: 0;
  padding-left: 1.5rem;
}

.buttons {
  margin-top: 1.5rem;
  text-align: center;
}

.buttons a {
  display: inline-block;
  margin: 0.5rem;
  padding: 0.75rem 1.5rem;
  background: #0078d7;
  color: #fff;
  text-decoration: none;
  border-radius: 4px;
  font-weight: bold;
  transition: background 0.3s ease;
}

.buttons a:hover {
  background: #005fa3;
}