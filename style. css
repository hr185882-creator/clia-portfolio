/* style.css – Hasan Kazmi CLIA Portfolio Theme */

body {
  font-family: "Segoe UI", Arial, sans-serif;
  margin: 0;
  padding: 0;
  background: #f9f9f9;
  color: #333;
  line-height: 1.6;
}

/* Banner + Overlay */
.banner {
  position: relative;
  width: 100%;
  height: auto;
}

.banner img {
  width: 100%;
  height: auto;
  display: block;
}

.banner .overlay {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  text-align: center;
  color: white;
  padding: 1rem 2rem;
  border-radius: 6px;
  background: linear-gradient(
    rgba(0, 0, 0, 0.6),
    rgba(0, 0, 0, 0.2)
  );
  animation: fadeIn 1.5s ease-in-out; /* smooth fade-in */
}

.banner .overlay h1 {
  margin: 0;
  font-size: 2.5rem;
  font-weight: bold;
  text-shadow: 2px 2px 4px rgba(0,0,0,0.7);
}

.banner .overlay p {
  margin-top: 0.5rem;
  font-size: 1.2rem;
  text-shadow: 1px 1px 3px rgba(0,0,0,0.7);
}

/* Sections */
section {
  padding: 2rem;
  max-width: 900px;
  margin: auto;
}

h2 {
  color: #222;
  margin-top: 2rem;
  font-size: 1.5rem;
  border-bottom: 2px solid #0078d7;
  padding-bottom: 0.5rem;
}

ul {
  margin: 0;
  padding-left: 1.5rem;
}

/* Buttons */
.buttons {
  margin-top: 1.5rem;
}

.buttons a {
  display: inline-block;
  margin: 0.5rem;
  padding: 0.75rem 1.5rem;
  background: #0078d7;
  color: #fff;
  text-decoration: none;
  border-radius: 4px;
  transition: background 0.3s ease;
}

.buttons a:hover {
  background: #005fa3;
}

